# CV service settings (all optional - defaults shown).
# On Windows PowerShell set them with:  $env:HF_HUB_OFFLINE="1"
# On macOS/Linux:                        export HF_HUB_OFFLINE=1

# After `python -m scripts.download_models` has run once, stay offline:
HF_HUB_OFFLINE=1

# Shared secret between the Express server and this service. If you set it here,
# set the SAME value as CV_API_KEY in server/.env.
CV_API_KEY=

# CPU threads for PyTorch (default = all cores).
# CV_TORCH_THREADS=4

# Folders (defaults are inside cv-service/)
# CV_DATASET_DIR=./dataset
# CV_BANKS_DIR=./banks
# CV_MODELS_DIR=./models
