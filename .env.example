# ── Database (Neon in prod, local Postgres in dev) ──
# Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/bukc?sslmode=require
# Local (docker-compose): postgresql://bukc:bukc@localhost:5433/bukc
DATABASE_URL=postgresql://bukc:bukc@localhost:5433/bukc

# ── Server ──
PORT=4000
NODE_ENV=development
# comma-separated origins allowed to call the API / receive cookies
CLIENT_ORIGIN=http://localhost:5173

# ── Auth (AUTH-08/09/10) ──
# generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_MIN=30          # AUTH-09: 15–60 min
REFRESH_TOKEN_TTL_DAYS=14
BCRYPT_ROUNDS=12                 # AUTH-08

# ── Email (Resend in dev; swap provider in prod) ──
EMAIL_PROVIDER=resend            # resend | console  (console just logs, for offline dev)
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="BUKC Sports <noreply@bukc-sports.dev>"

# ── Seed super admin (db/seed) ──
SEED_SUPERADMIN_EMAIL=admin@bukc.edu.pk
SEED_SUPERADMIN_PASSWORD=AdminPass123!
SEED_SUPERADMIN_NAME=System Administrator
