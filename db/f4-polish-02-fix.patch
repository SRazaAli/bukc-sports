From 8c343020cd055b6fae47f57d45abba6e69be975a Mon Sep 17 00:00:00 2001
From: Raza <raza@bukc.edu.pk>
Date: Thu, 23 Jul 2026 20:32:52 +0000
Subject: [PATCH] fix(db): migration 012 fails on existing non-12-digit
 barcodes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The new ck_article_barcode_format constraint (exactly 12 digits) rejects any
article entered under the old free-form barcode format before this patch —
which any dev/test data from earlier Feature 4 testing will have.

Two real problems, both caught by running the migration against a database
seeded with legacy-format barcodes (not just reviewing the SQL):

1. No conversion step — the ALTER TABLE ADD CONSTRAINT immediately fails on
   any non-conforming existing row. Fixed by auto-converting non-conforming
   barcodes to valid, unique 12-digit codes (prefixed with 9, generated from
   row order) before the constraint is added.

2. That conversion UPDATE itself got blocked by the tg_article_guard trigger,
   which enforces INV-05 (barcode is immutable) — changing a barcode value
   in an UPDATE statement is exactly what that trigger exists to prevent, so
   it fired on the migration's own fix-up. Fixed by disabling the trigger
   around this one specific statement (a one-time format migration, not an
   in-app edit) and re-enabling it immediately after.

Verified against a database seeded with legacy barcodes ('BR-A01', 'BR-B01')
— they convert cleanly to ('900000000001', '900000000002') and the
migration completes. Full migration set (001-012) and the inventory/
availability/equipment-allocation test suites re-verified clean afterward
(41/41 passing).
---
 .../012_pair_model_and_scan_polish.sql        | 20 +++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/db/migrations/012_pair_model_and_scan_polish.sql b/db/migrations/012_pair_model_and_scan_polish.sql
index 6dbfccc..5318e5a 100644
--- a/db/migrations/012_pair_model_and_scan_polish.sql
+++ b/db/migrations/012_pair_model_and_scan_polish.sql
@@ -134,6 +134,26 @@ SELECT v.equipment_type_id, v.name, v.sport_category_id, v.available_units,
 FROM v_article_availability v JOIN equipment_type et USING (equipment_type_id);
 
 -- ── 2. Barcode format: UPC-A, 12 numeric digits ──
+-- Existing articles entered under the old free-form format won't match the
+-- new constraint — auto-convert them to valid, unique 12-digit codes first
+-- (prefixed with 9 so they're visibly distinguishable as migrated values and
+-- can't collide with anything entered under the old or new format). This is
+-- the one legitimate exception to INV-05 (barcode immutable) — a one-time
+-- format migration, not an in-app edit — so the guard trigger is bypassed
+-- only for this statement and restored immediately after.
+ALTER TABLE article DISABLE TRIGGER tg_article_guard;
+
+WITH renumbered AS (
+  SELECT article_id, lpad((900000000000 + row_number() OVER (ORDER BY entered_at))::text, 12, '0') AS new_barcode
+  FROM article
+  WHERE barcode !~ '^[0-9]{12}$'
+)
+UPDATE article a SET barcode = r.new_barcode
+FROM renumbered r
+WHERE a.article_id = r.article_id;
+
+ALTER TABLE article ENABLE TRIGGER tg_article_guard;
+
 ALTER TABLE article DROP CONSTRAINT IF EXISTS ck_article_barcode_length;
 ALTER TABLE article ADD CONSTRAINT ck_article_barcode_format
   CHECK (barcode ~ '^[0-9]{12}$');
-- 
2.43.0

